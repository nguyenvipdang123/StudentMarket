# Copy to .env.local only when creating a new installation. Never commit real credentials.
APP_ORIGIN=http://localhost:3000
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=student_market
PG_USER=postgres
PG_PASSWORD=
# Render supplies DATABASE_URL. When set, it takes precedence over PG_* above.
# DATABASE_URL=
PG_POOL_MAX=5
# Internal Render network: disable. External verified TLS: verify-full.
# PG_SSL_MODE=disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Generate a secret with at least 32 characters, shared by Next.js and FastAPI.
CHAT_TICKET_SECRET=
# Optional separate server-only secret; otherwise CHAT_TICKET_SECRET is used.
EMAIL_CODE_SECRET=
NEXT_PUBLIC_CHAT_WS_URL=ws://localhost:8000
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=
# PRODUCT_IMAGE_DIR=
# Server-only image storage. See docs/storage.md before enabling on a deployed server.
MEDIA_STORAGE_PROVIDER=local
# Temporary migration aid only; keep false on the deployed server.
MEDIA_STORAGE_READ_LOCAL_FALLBACK=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy service_role JWT is also supported; never use an anon/publishable key here.
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PRODUCT_BUCKET=studentmarket-products
SUPABASE_CARD_BUCKET=studentmarket-cards
SUPABASE_CHAT_BUCKET=studentmarket-chat
# STUDENT_CARD_DIR=
# CHAT_ATTACHMENT_DIR=
PDF_CHAT_GRAPH_URL=http://127.0.0.1:2024
PDF_CHAT_APP_URL=http://127.0.0.1:3001
GEMINI_API_KEY=
GEMINI_MODERATION_MODEL=gemini-3.1-flash-lite

# SePay QR bank transfers for listing promotions. Server-only; see docs/sepay.md.
SEPAY_ENABLED=false
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_AUTH=hmac
SEPAY_WEBHOOK_SECRET=
SEPAY_ORDER_PREFIX=ST
# Optional VA / bank-specific transfer memo.
SEPAY_QR_ACCOUNT=
SEPAY_SUB_ACCOUNT=
SEPAY_DESCRIPTION_PREFIX=
