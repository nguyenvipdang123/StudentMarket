    "test:storage": "node --experimental-strip-types --test scripts/media-storage.test.mjs",
    "test:storage-integration": "node scripts/test-storage-integration.mjs",
    "test:ai-storage-integration": "node scripts/test-ai-storage-integration.mjs",
