{
  "expo": {
    "name": "SangTay",
    "slug": "sangtay-mobile",
    "scheme": "sangtay",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "shop.sangtay.mobile",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép SangTay chọn ảnh món đồ để đăng tin.",
          "cameraPermission": "Cho phép SangTay chụp ảnh món đồ để đăng tin.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {}
      ]
    ]
  }
}
